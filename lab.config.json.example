{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Azure Monitor Lab — central per-user config",
  "description": "Copy this file to lab.config.json (gitignored) and fill in real values. Then run scripts/sync-config.ps1 (or scripts/deploy.ps1, which calls it for you) to materialize .azure-target.json, infra/main.parameters.json and terraform/stages.tfvars from these values. This is the ONE place you need to edit when bootstrapping the lab.",

  "subscriptionId":   "<YOUR-SUBSCRIPTION-ID>",
  "subscriptionName": "<YOUR-SUBSCRIPTION-NAME>",
  "tenantId":         "<YOUR-TENANT-ID>",

  "alertEmail":       "your.alias@example.com",
  "vmAdminPassword":  "<STRONG-PASSWORD>",

  "resourceGroup":    "rg-azure-monitor-lab",
  "location":         "northeurope",
  "namePrefix":       "amlab",
  "vmAdminUsername":  "azureuser",
  "dailyCapGb":       1,
  "aksNodeCount":     2,
  "grafanaAdminObjectId": "",
  "_grafanaAdminObjectIdDocs": "Leave empty to grant Grafana Admin to the deploying identity. When a pipeline deploys, set the Microsoft Entra object ID of the human lab operator or group that must access Grafana, not an application client ID.",
  "deployWindowsVm":  true,
  "deployLinuxVm":    true,

  "enableLawReplication":   false,
  "lawReplicationLocation": "",
  "_lawReplicationLocationDocs": "lawReplicationLocation is required when enableLawReplication is true and must be a supported secondary region for the primary 'location' above — see https://learn.microsoft.com/en-us/azure/azure-monitor/logs/workspace-replication?tabs=azure-cli#supported-regions",

  "siemWebhookUrl":   "",
  "forbiddenSubscriptionIds": [],

  "stageToggles": {
    "enableStageA": true,
    "enableStageB": true,
    "enableStageC": true,
    "enableStageD": true,
    "enableStageE": true,
    "enableStageAI": false,
    "enableStageSreAgent": false
  }
}
