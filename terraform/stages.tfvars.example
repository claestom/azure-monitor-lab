# Copy this file to stages.tfvars and fill in real values.
# stages.tfvars is gitignored (it contains the VM admin password).
#
# Usage:
#   cp stages.tfvars.example stages.tfvars
#   # edit stages.tfvars, then:
#   terraform plan  -var-file stages.tfvars
#   terraform apply -var-file stages.tfvars

subscription_id     = "00000000-0000-0000-0000-000000000000"

# Resource group is BYO (bring-your-own). Create it BEFORE running terraform apply:
#   az group create -n <resource_group_name> -l <location>
# Terraform looks the RG up via data source and only manages resources INSIDE it.
# `terraform destroy` will NOT delete the RG itself.
# If you omit resource_group_name, the default "rg-azure-monitor-lab" is used.
resource_group_name = "rg-azure-monitor-lab"

location            = "northeurope"
alert_email         = "your.alias@example.com"
vm_admin_password   = "<STRONG-PASSWORD>"
grafana_admin_object_id = ""

# Stage toggles - enable one at a time the first time through, then flip the
# next one and re-run plan/apply. Each new stage adds exactly one
# azapi_resource.stage_* to the plan.
enable_stage_a = true   # Foundation (LAW, DCR, AMW, Grafana, App Insights, workbooks)
enable_stage_b = false  # Workloads (App Service, AKS, VMs, VMSS, Connection Monitor)
enable_stage_c = false  # Alerting (metric/log/health alerts, action groups, AMBA, Prom rules)
enable_stage_d = false  # Security posture (Sentinel, custom logs, exfil early warning)
enable_stage_e = false  # Optional advanced (auto-mitigation Logic App, availability test, etc.)

# Optional AI stage - Microsoft Foundry GenAI workload (account, project, chat/embed/
# optimize/model-router deployments) + App Insights connection + token metric alerts.
# Pinned to swedencentral (ai_location) independent of `location`; depends on Stage A.
# Off by default: it deploys billable AI models and needs region-confirmed model versions.
# After apply, run scripts/setup-ai.ps1 to create the demo agents and simulate traffic.
enable_stage_ai      = false            # AI (Foundry + models + token alerts)
ai_location          = "swedencentral"  # region for the Foundry account + models
router_model_version = "2025-08-07"     # VERIFY: az cognitiveservices account list-models

# Optional SRE Agent stage - preview Azure SRE Agent, connectors, identities, and RBAC.
# Hard pinned to swedencentral by the Stage 60 Bicep module; depends on Stage A.
# Off by default because active usage is billable and always-on billing can begin
# after an eligible trial. The deploying identity needs subscription role-assignment permission.
enable_stage_sre_agent = false

# Optional preview/GA telemetry features (part of Stage E). Off by default because
# the DCR and the central LAW must be in the same region and the platform-logs DCR
# is still in public preview (region-limited). Flip to true once you've confirmed
# your region is supported.
enable_platform_logs_dcr  = false  # Scenario 51 - platform logs at scale via DCR (public preview)
enable_metrics_export_dcr = false  # Scenario 52 - metrics export via DCR (GA)
