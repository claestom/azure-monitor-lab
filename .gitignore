main.parameters.json
.rbac-demo-config.json

# Local deploy/test logs
*.log

# Terraform local working files
terraform/.terraform/
terraform/*.plan
# Real inputs (mirrors main.parameters.json) — use stages.tfvars.example as template
terraform/stages.tfvars

# AI workload local files (secrets + generated agent ids)
workloads/ai/.env
workloads/ai/agents.json
workloads/ai/.venv/
workloads/ai/__pycache__/

# Ad-hoc compiled JSON from test deployments
infra/*.terraform-test.json

# Editor / IDE
.vscode/

# Personal Lab Feature Check agent and checklist
/.github/agents/lab-feature-check.agent.md

# Ad-hoc scratch scripts (not for source control)
scripts/temp.ps1

